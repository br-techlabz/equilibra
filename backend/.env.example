# Equilibra - Variáveis de Ambiente para Docker Compose
# Copie este arquivo para .env e ajuste os valores conforme necessário
# O arquivo .env real NÃO deve ser versionado (está no .gitignore)

# ============================================================
# MySQL
# ============================================================
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=equilibra
MYSQL_PASSWORD=equilibra
MYSQL_PORT=3306

# ============================================================
# Frontend
# ============================================================
FRONTEND_PORT=4201

# ============================================================
# CORS - Origins permitidos para acessar o backend
# Separe múltiplas origins por vírgula (sem espaços)
# Ex: http://192.168.1.100:4201,https://meudominio.com
# ============================================================
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4202

# ============================================================
# JWT (OBRIGATÓRIO em produção)
# Gere um secret seguro: openssl rand -base64 32
# ============================================================
EQUILIBRA_JWT_SECRET=dev-only-change-me-not-for-production-32-bytes-minimum
EQUILIBRA_JWT_ISSUER=equilibra-api
EQUILIBRA_JWT_ACCESS_TOKEN_TTL=15m
EQUILIBRA_REFRESH_TOKEN_TTL=30d
EQUILIBRA_REFRESH_COOKIE_SECURE=false

# ============================================================
# Anexos
# ============================================================
EQUILIBRA_ATTACHMENTS_STORAGE_TYPE=local
EQUILIBRA_ATTACHMENTS_LOCAL_ROOT=var/attachments
EQUILIBRA_ATTACHMENTS_MAX_FILE_SIZE=10485760
EQUILIBRA_ATTACHMENTS_MAX_PER_TRANSACTION=10

# ============================================================
# Timezone
# ============================================================
TZ=America/Sao_Paulo
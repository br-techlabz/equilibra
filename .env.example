# ============================================================
# Equilibra - Variáveis de Ambiente para Desenvolvimento
# ============================================================
# Copie este arquivo para .env e ajuste se necessário.
# NUNCA commite o arquivo .env real!
# ============================================================

# MySQL
MYSQL_ROOT_PASSWORD=root
MYSQL_USER=equilibra
MYSQL_PASSWORD=equilibra

# Backend Spring Boot
SPRING_PROFILES_ACTIVE=docker
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/equilibra?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=equilibra
SPRING_DATASOURCE_PASSWORD=equilibra

# JWT (exemplo de desenvolvimento; use valor próprio de alta entropia no .env real)
EQUILIBRA_JWT_ISSUER=equilibra-api
EQUILIBRA_JWT_ACCESS_TOKEN_TTL=15m
EQUILIBRA_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long